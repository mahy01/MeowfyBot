FROM dunglas/frankenphp:php8.3-bookworm

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ffmpeg \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY . /app

RUN mkdir -p /app/storage \
    && chmod -R 777 /app/storage

ENV SERVER_NAME=:80

CMD ["frankenphp", "php-server", "--listen", ":80", "--root", "/app"]
